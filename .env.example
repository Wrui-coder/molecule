# 复制为 .env.local 后填写（.env* 已被 .gitignore 忽略，不会进仓库）
# Anthropic 兼容端点：官方 https://api.anthropic.com，或任意兼容中转
ANTHROPIC_BASE_URL=https://your-anthropic-compatible-endpoint
ANTHROPIC_AUTH_TOKEN=sk-xxxxxx
# 任意 Anthropic 兼容模型名；本 Demo 线上部署实际使用 deepseek-v4-flash
ANTHROPIC_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=64000
LLM_THINKING_BUDGET=2000
# 留空则使用本地内嵌 Postgres（PGlite）；部署时填 Neon 连接串
DATABASE_URL=
